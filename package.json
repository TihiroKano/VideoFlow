{
  "name": "videoflow",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "VideoFlow - 液态玻璃桌面视频下载器（测试开发版）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "tauri": "tauri",
    "app": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "app:preview": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1 preview"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}